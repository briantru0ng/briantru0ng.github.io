# ---- Events feature env vars ----
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Locally, copy this file to ".env" (gitignored) to test.

# Secret used to sign event-unlock cookies. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Node.js).
# The code uses database name "events" and collection "rsvps".
MONGODB_URI=

# One password per event, keyed by the UPPERCASED slug with non-alphanumerics -> _
# Slug "friendsgiving2026"  ->  EVENT_PW_FRIENDSGIVING2026
EVENT_PW_FRIENDSGIVING2026=
