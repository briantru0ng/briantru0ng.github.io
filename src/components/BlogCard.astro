---
import { publicAssetExists } from '../lib/publicAsset';

interface Props {
  title: string;
  description: string;
  date: Date;
  image?: string;
  slug: string;
  category: 'food' | 'art' | 'life';
}

const { title, description, date, slug, category } = Astro.props;
const image = publicAssetExists(Astro.props.image) ? Astro.props.image : undefined;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const href = `/blog/${category}/${slug}`;
const initial = title.trim().charAt(0).toUpperCase();
---

<a href={href} class="blog-card">
  <div class="blog-card-media">
    {image ? (
      <img src={image} alt="" class="blog-card-image" loading="lazy" />
    ) : (
      <span class="placeholder-initial" aria-hidden="true">{initial}</span>
    )}
  </div>
  <time class="blog-card-date meta" datetime={date.toISOString()}>{formattedDate}</time>
  <h3 class="blog-card-title">{title}</h3>
  <p class="blog-card-description">{description}</p>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .blog-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    margin-bottom: 0.875rem;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  /* Outline sits above the image so it reads as an edge, not a border */
  .blog-card-media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
    transition: opacity 150ms var(--ease-out);
  }

  .blog-card-date {
    display: block;
    margin-bottom: 0.25rem;
  }

  .blog-card-title {
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: 0.375rem;
    transition: color 150ms var(--ease-out);
  }

  .blog-card-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card:hover .blog-card-title {
    color: var(--color-accent);
  }

  .blog-card:hover .blog-card-image {
    opacity: 1;
  }
</style>
