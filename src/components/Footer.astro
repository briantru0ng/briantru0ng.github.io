---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-row">
      <p class="footer-text">
        &copy; {currentYear} Brian Truong <span class="footer-sep" aria-hidden="true">/</span> set in Creato Display
      </p>
      <div class="footer-links">
        <a href="https://github.com/briantru0ng" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://linkedin.com/in/briantru0ng" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--spacing-md);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-md);
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-sep {
    margin: 0 0.25rem;
    color: var(--color-border);
  }

  .footer-links {
    display: flex;
    gap: var(--spacing-sm);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: var(--spacing-md) var(--spacing-sm);
    }
  }
</style>
