---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  image?: string;
  tags?: string[];
  category: 'food' | 'art' | 'life';
  headings?: MarkdownHeading[];
}

const { title, description, date, image, tags, category, headings = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const categoryLabel = category === 'food' ? 'Food Blog' : category === 'art' ? 'Art Blog' : 'Life Blog';
const backLink = `/blog/${category}`;

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

<BaseLayout title={title} description={description}>
  <article class="blog-post">
    <div class="container">
      <a href={backLink} class="back-link"><span aria-hidden="true">←</span> {categoryLabel}</a>

      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-meta">
          <time class="meta" datetime={date.toISOString()}>{formattedDate}</time>
          {tags && tags.length > 0 && (
            <div class="post-tags">
              {tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </div>
      </header>

      {image && (
        <div class="post-image-wrapper">
          <img src={image} alt={title} class="post-image" />
        </div>
      )}

      <div class="post-body">
        <div class="post-content prose">
          <slot />
        </div>

        {tocHeadings.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <p class="toc-title meta">Contents</p>
            <ul class="toc-list">
              {tocHeadings.map(heading => (
                <li class={`toc-item depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      {tocHeadings.length > 0 && (
        <script>
          const tocLinks = document.querySelectorAll('.toc-item a');
          const headingIds = Array.from(tocLinks).map(a => a.getAttribute('href')?.slice(1)).filter(Boolean);
          const headings = headingIds.map(id => document.getElementById(id as string)).filter(Boolean) as HTMLElement[];

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  tocLinks.forEach(a => a.classList.remove('active'));
                  const active = document.querySelector(`.toc-item a[href="#${entry.target.id}"]`);
                  if (active) active.classList.add('active');
                }
              });
            },
            { rootMargin: '-60px 0px -70% 0px', threshold: 0 }
          );

          headings.forEach(h => observer.observe(h));
        </script>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding: var(--spacing-md) 0 var(--spacing-xl);
  }

  .post-header {
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }

  .post-title {
    max-width: 900px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: var(--spacing-sm) 0;
  }

  .post-description {
    font-size: 1.125rem;
    max-width: 56ch;
    margin-bottom: var(--spacing-md);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem var(--spacing-sm);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .post-image-wrapper {
    position: relative;
    margin-bottom: var(--spacing-lg);
    border-radius: 4px;
    overflow: hidden;
  }

  .post-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }

  .post-image {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
  }

  .post-body {
    display: flex;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  /* ── TOC sidebar ── */
  .toc {
    flex-shrink: 0;
    width: 200px;
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    max-height: calc(100vh - var(--nav-height) - 3rem);
    overflow-y: auto;
  }

  .toc-title {
    margin: 0 0 0.75rem 0;
  }

  .toc-list {
    list-style: none;
    padding: 0 0 0 0.875rem;
    margin: 0;
    border-left: 1px solid var(--color-border);
  }

  /* depth-2: top-level section */
  .toc-item.depth-2 {
    margin-bottom: 0.25rem;
  }

  .toc-item.depth-2 ~ .toc-item.depth-2 {
    margin-top: 0.5rem;
  }

  .toc-item.depth-2 > a {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
  }

  /* depth-3: sub-section */
  .toc-item.depth-3 {
    padding-left: 0.625rem;
    margin-bottom: 0.2rem;
  }

  .toc-item.depth-3 > a {
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  /* depth-4: leaf */
  .toc-item.depth-4 {
    padding-left: 1.25rem;
    margin-bottom: 0.15rem;
  }

  .toc-item.depth-4 > a {
    font-size: 0.74rem;
    color: var(--color-text-muted);
    opacity: 0.65;
  }

  .toc-item > a {
    display: block;
    line-height: 1.4;
    padding: 0.125rem 0;
    transition: color 150ms var(--ease-out), opacity 150ms var(--ease-out);
  }

  .toc-item > a:hover,
  .toc-item > a.active {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .toc {
      display: none;
    }
  }
</style>
