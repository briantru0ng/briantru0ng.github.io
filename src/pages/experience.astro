---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const experiences = await getCollection('experience', ({ data }) => data.shown);
const education = await getCollection('education', ({ data }) => data.shown);
const publications = await getCollection('publications', ({ data }) => data.shown);

const MONTH_YEAR: Intl.DateTimeFormatOptions = { month: 'short', year: 'numeric', timeZone: 'UTC' };

// Format date range in UTC to prevent timezone offset issues
function formatDateRange(startDate: Date, endDate?: Date) {
  const start = startDate.toLocaleDateString('en-US', MONTH_YEAR);
  if (!endDate) return `${start} – Present`;
  const end = endDate.toLocaleDateString('en-US', MONTH_YEAR);
  return start === end ? start : `${start} – ${end}`;
}

// order === 0 marks examples/hidden items. Sort by `order`, then newest first.
function curated<T extends { data: { order?: number } }>(items: T[], dateOf: (item: T) => Date) {
  return items
    .filter(item => item.data.order !== 0)
    .sort((a, b) => {
      if (a.data.order != null && b.data.order != null) return a.data.order - b.data.order;
      return dateOf(b).valueOf() - dateOf(a).valueOf();
    });
}

const work = await Promise.all(
  curated(experiences, e => e.data.startDate).map(async exp => ({
    key: exp.id,
    when: formatDateRange(exp.data.startDate, exp.data.endDate),
    title: exp.data.role,
    org: exp.data.company,
    location: exp.data.location,
    tags: exp.data.tags,
    Content: (await exp.render()).Content,
  })),
);

const papers = await Promise.all(
  curated(publications, p => p.data.date).map(async pub => ({
    key: pub.id,
    when: pub.data.date.toLocaleDateString('en-US', MONTH_YEAR),
    title: pub.data.title,
    org: pub.data.venue,
    authors: pub.data.authors,
    tags: pub.data.tags,
    link: pub.data.link ? { href: pub.data.link, label: 'View paper' } : undefined,
    Content: (await pub.render()).Content,
  })),
);

const toSchooling = async (edu: (typeof education)[number]) => ({
  key: edu.id,
  when: formatDateRange(edu.data.startDate, edu.data.endDate),
  title: edu.data.degree,
  org: edu.data.institution,
  location: edu.data.location,
  tags: edu.data.tags,
  link: edu.data.credentialLink ? { href: edu.data.credentialLink, label: 'Show credential' } : undefined,
  Content: (await edu.render()).Content,
});

const degrees = await Promise.all(
  curated(education.filter(e => e.data.type === 'degree'), e => e.data.startDate).map(toSchooling),
);
const certifications = await Promise.all(
  curated(education.filter(e => e.data.type === 'certification'), e => e.data.startDate).map(toSchooling),
);

const sections = [
  { id: 'work', label: 'Work Experience', entries: work },
  { id: 'publications', label: 'Publications', entries: papers },
  { id: 'education', label: 'Education', entries: degrees },
  { id: 'certifications', label: 'Certifications', entries: certifications },
].filter(section => section.entries.length > 0);
---

<BaseLayout title="Brian's Experience" description="Brian Truong's work experience">
  <div class="container">
    <header id="top" class="page-header">
      <h1 class="page-title">Experience</h1>
      <p class="page-description">My professional journey so far.</p>

      <nav class="section-tabs" aria-label="Jump to section">
        {sections.map(section => (
          <a href={`#${section.id}`} class="section-tab" data-section={section.id}>
            {section.label} <span class="meta">{section.entries.length}</span>
          </a>
        ))}
      </nav>
    </header>

    {sections.map(section => (
      <section id={section.id} class="cv-section">
        <header class="cv-section-header">
          <h2 class="cv-section-title">{section.label}</h2>
          <span class="meta cv-count">{String(section.entries.length).padStart(2, '0')}</span>
        </header>

        <ol class="cv-list">
          {section.entries.map(({ Content, ...entry }) => (
            <li class="cv-item">
              <p class="cv-when meta">
                {entry.when.endsWith('Present') ? (
                  <>{entry.when.replace('Present', '')}<span class="cv-present">Present</span></>
                ) : entry.when}
              </p>
              <div class="cv-body">
                <h3 class="cv-title">{entry.title}</h3>
                <p class="cv-org">
                  {entry.org}
                  {'location' in entry && entry.location && <span class="cv-location"> · {entry.location}</span>}
                </p>

                {'authors' in entry && entry.authors && entry.authors.length > 0 && (
                  <p class="cv-authors">{entry.authors.join(', ')}</p>
                )}

                <div class="cv-content">
                  <Content />
                </div>

                {entry.tags && entry.tags.length > 0 && (
                  <div class="cv-tags">
                    {entry.tags.map(tag => <span class="tag">{tag}</span>)}
                  </div>
                )}

                {'link' in entry && entry.link && (
                  <a href={entry.link.href} class="cv-link" target="_blank" rel="noopener noreferrer">
                    {entry.link.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLAnchorElement>('.section-tab');

  function setActiveTab(sectionId: string | null) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.section === sectionId));
  }

  // Handle tab clicks - scroll directly to section
  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      const sectionId = tab.dataset.section;
      const section = sectionId ? document.getElementById(sectionId) : null;
      if (!section || !sectionId) return;

      e.preventDefault();
      setActiveTab(sectionId);
      history.pushState(null, '', `#${sectionId}`);
      section.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Set active tab based on current hash on load
  const hash = window.location.hash.slice(1);
  if (hash) setActiveTab(hash);

  // Back to top button
  const backToTop = document.getElementById('back-to-top');
  const SHOW_AFTER_PX = 300;
  window.addEventListener('scroll', () => {
    backToTop?.classList.toggle('visible', window.scrollY > SHOW_AFTER_PX);
  }, { passive: true });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setActiveTab(null);
    history.pushState(null, '', window.location.pathname);
  });
</script>

<style>
  /* ── Jump links ── */
  .section-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .section-tab {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 40px;
    padding-top: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .section-tab:hover,
  .section-tab.active {
    color: var(--color-text);
  }

  .section-tab.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--color-accent);
  }

  /* ── Sections ── */
  .cv-section {
    margin-bottom: calc(var(--spacing-lg) + var(--spacing-sm));
    scroll-margin-top: calc(var(--nav-height) + var(--spacing-sm));
  }

  .cv-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-accent);
  }

  .cv-count,
  .cv-present,
  .section-tab .meta {
    color: var(--color-accent);
  }

  .cv-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .cv-list {
    list-style: none;
  }

  .cv-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-when {
    padding-top: 0.35rem;
    margin: 0;
  }

  .cv-body {
    max-width: var(--content-width);
  }

  .cv-title {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 0.125rem;
  }

  .cv-org {
    color: var(--color-text);
    opacity: 0.85;
    margin-bottom: var(--spacing-sm);
  }

  .cv-location {
    color: var(--color-text-muted);
  }

  .cv-authors {
    font-size: 0.875rem;
    margin-bottom: var(--spacing-sm);
  }

  .cv-content {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .cv-content :global(h2) {
    font-size: 1rem;
    color: var(--color-text);
    margin: var(--spacing-sm) 0 var(--spacing-xs);
  }

  .cv-content :global(p) {
    margin-bottom: var(--spacing-xs);
  }

  .cv-content :global(ul) {
    list-style: none;
  }

  .cv-content :global(li) {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.375rem;
  }

  .cv-content :global(li)::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--spacing-sm);
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .cv-link:hover {
    color: var(--color-accent);
  }

  /* ── Back to top ── */
  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 10px;
    background: var(--color-bg-elevated);
    color: var(--color-text);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 8px 20px -6px rgb(0 0 0 / 0.5);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    translate: 0 8px;
    transition-property: opacity, visibility, translate, color, scale;
    transition-duration: 200ms;
    transition-timing-function: var(--ease-out);
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .back-to-top:hover {
    color: var(--color-accent);
  }

  .back-to-top:active {
    scale: 0.96;
  }

  @media (max-width: 768px) {
    .cv-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .cv-when {
      padding-top: 0;
    }

    .back-to-top {
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
