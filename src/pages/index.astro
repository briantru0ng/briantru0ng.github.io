---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const RECENT_COUNT = 4;

const monthYear = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// Same ordering as /projects: curated `order` first, otherwise newest first
const projects = (await getCollection('projects', ({ data }) => data.shown && data.order !== 0))
  .sort((a, b) => {
    if (a.data.order != null && b.data.order != null) return a.data.order - b.data.order;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, RECENT_COUNT);

const posts = (await getCollection('blog', ({ data }) => data.shown))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, RECENT_COUNT)
  .map(post => {
    const [category, ...rest] = post.slug.split('/');
    return { post, category, href: `/blog/${category}/${rest.join('/')}` };
  });
---

<BaseLayout title="Brian's Home">
  <section class="hero container">
    <div class="hero-content">
      <p class="hero-kicker meta reveal" style="--i: 0">AI / ML Software Guy</p>
      <h1 class="hero-name reveal" style="--i: 1">Brian<br />Truong</h1>
      <p class="hero-description reveal" style="--i: 2">
        I create and develop things using AI and ML libraries <span class="hero-aside">where necessary.</span>
      </p>
      <nav class="hero-links reveal" style="--i: 3" aria-label="Sections">
        <a href="/about"><span class="link-label">More about me</span><span aria-hidden="true">→</span></a>
        <a href="/experience"><span class="link-label">Where I've worked</span><span aria-hidden="true">→</span></a>
      </nav>
    </div>

    <div class="tv-container reveal" style="--i: 2">
      <div class="tv-wrapper">
        <!-- Video layer (bottom) -->
        <video class="tv-video" autoplay muted loop playsinline>
          <source src="/videos/demo.mp4" type="video/mp4">
        </video>
        <!-- Screen overlay with lighten blend (middle) -->
        <img src="/images/crt_tv_screen.png" alt="" class="tv-screen-overlay" />
        <!-- TV base frame (top) -->
        <img src="/images/crt_tv_base.png" alt="Retro TV" class="tv-base" />
      </div>
    </div>
  </section>

  <section class="recent container" aria-label="Recent work and writing">
    <div class="recent-col">
      <header class="recent-header">
        <h2 class="recent-heading">Things I've built</h2>
        <a href="/projects" class="recent-all">All projects →</a>
      </header>
      <ol class="recent-list">
        {projects.map(project => (
          <li>
            <a href={`/projects/${project.slug}`} class="recent-row">
              <time class="meta" datetime={project.data.date.toISOString()}>{monthYear(project.data.date)}</time>
              <span class="recent-title">{project.data.title}</span>
              <span class="recent-end" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="recent-col">
      <header class="recent-header">
        <h2 class="recent-heading">Things I've written</h2>
        <a href="/about#blogs" class="recent-all">All posts →</a>
      </header>
      <ol class="recent-list">
        {posts.map(({ post, category, href }) => (
          <li>
            <a href={href} class="recent-row">
              <time class="meta" datetime={post.data.date.toISOString()}>{monthYear(post.data.date)}</time>
              <span class="recent-title">{post.data.title}</span>
              <span class="recent-end meta">{category}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <noscript>
    <style is:inline>.reveal { opacity: 1 !important; transform: none !important; }</style>
  </noscript>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-lg);
    /* leave the "recent" lists peeking above the fold */
    min-height: min(680px, calc(100svh - var(--nav-height) - 5rem));
    padding-block: var(--spacing-lg) var(--spacing-md);
  }

  .hero-kicker {
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent);
  }

  .hero-name {
    font-size: clamp(3.75rem, 11vw, 8.5rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    margin-bottom: var(--spacing-md);
  }

  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 300;
    line-height: 1.5;
    max-width: 30ch;
    margin-bottom: var(--spacing-md);
  }

  .hero-aside {
    color: var(--color-text);
    font-weight: 400;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--spacing-md);
  }

  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    color: var(--color-text);
    font-size: 1.0625rem;
  }

  .link-label {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .hero-links a:hover {
    color: var(--color-accent);
  }

  /* One-time staged entrance, triggered after the loading screen */
  .reveal {
    opacity: 0;
    transform: translateY(8px);
  }

  :global(body.content-loaded) .reveal {
    animation: rise 500ms var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 100ms);
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── CRT TV (layer positions are tuned to the PNGs; leave as-is) ── */
  .tv-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 520px;
    justify-self: end;
  }

  .tv-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .tv-base {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 3;
    pointer-events: none;
  }

  .tv-screen-overlay {
    position: absolute;
    top: 10%;
    left: 10%;
    width: 80%;
    height: 80%;
    object-fit: cover;
    z-index: 2;
    mix-blend-mode: lighten;
    pointer-events: none;
    opacity: 0.3;
  }

  .tv-video {
    position: absolute;
    top: 16%;
    left: 11%;
    width: 55%;
    height: 65%;
    object-fit: cover;
    z-index: 1;
    border-radius: 8px;
  }

  /* ── Recent index ── */
  .recent {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-lg);
    padding-block: var(--spacing-md) var(--spacing-xl);
  }

  .recent-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .recent-heading {
    font-size: 1.25rem;
    margin: 0;
  }

  .recent-all {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .recent-all:hover {
    color: var(--color-text);
  }

  .recent-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .recent-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--spacing-sm);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .recent-title {
    transition: color 150ms var(--ease-out);
  }

  .recent-end {
    color: var(--color-text-muted);
    transition: color 150ms var(--ease-out);
  }

  .recent-row:hover .recent-title,
  .recent-row:hover .recent-end {
    color: var(--color-accent);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: var(--spacing-md);
    }

    .tv-container {
      justify-self: center;
      max-width: 440px;
    }

    .recent {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 480px) {
    .recent-row {
      grid-template-columns: 4.75rem minmax(0, 1fr) auto;
      gap: 0.75rem;
    }
  }
</style>
