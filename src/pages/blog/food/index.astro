---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ id, data }) => id.startsWith('food/') && data.shown);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const countTagged = (tag: string) => sortedPosts.filter(post => post.data.tags?.includes(tag)).length;

const filters = [
  { value: 'all', label: 'All', count: sortedPosts.length },
  { value: 'recipe', label: 'Recipe', count: countTagged('recipe') },
  { value: 'review', label: 'Review', count: countTagged('review') },
];
---

<BaseLayout title="Brian's Food" description="Culinary adventures and recipes by Brian Truong">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Food Blog</h1>
      <p class="page-description">
        Oh I'm big backing it. Oh I'm big backing it. Oh I'm big bac-
      </p>

      <div class="filter-tabs" role="group" aria-label="Filter posts">
        {filters.map((filter, i) => (
          <button
            class:list={['filter-tab', { active: i === 0 }]}
            type="button"
            data-filter={filter.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {filter.label} <span class="meta">{filter.count}</span>
          </button>
        ))}
      </div>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="blog-grid" id="blog-grid">
        {sortedPosts.map(post => (
          <div class="card-wrapper" data-tags={post.data.tags?.join(',') ?? ''}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              image={post.data.image}
              slug={post.slug.replace('food/', '')}
              category="food"
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No food posts yet? I am not real.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .filter-tabs {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    margin-top: var(--spacing-md);
    border-radius: 9px; /* 6px inner + 3px padding */
    background: var(--color-bg-elevated);
  }

  .filter-tab {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.5rem 0.9rem;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-family);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out), color 150ms var(--ease-out);
  }

  .filter-tab:hover {
    color: var(--color-text);
  }

  .filter-tab.active {
    background: var(--color-border);
    color: var(--color-text);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-lg) var(--spacing-md);
    padding-bottom: var(--spacing-xl);
  }

  .card-wrapper {
    display: contents;
  }

  .card-wrapper.hidden {
    display: none;
  }

  .empty-state {
    padding: var(--spacing-lg) 0 var(--spacing-xl);
  }

  .empty-state p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('.card-wrapper');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        const isActive = t === tab;
        t.classList.toggle('active', isActive);
        t.setAttribute('aria-pressed', String(isActive));
      });

      const filter = tab.dataset.filter ?? 'all';
      cards.forEach(card => {
        const tags = card.dataset.tags ?? '';
        card.classList.toggle('hidden', filter !== 'all' && !tags.split(',').includes(filter));
      });
    });
  });
</script>
