---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { cookieName, verifyToken } from '../../lib/eventAuth';
import { getRsvps, type Rsvp } from '../../lib/db';

const { slug } = Astro.params;

const events = await getCollection('events');
const entry = slug ? events.find((e) => e.slug === slug) : undefined;

if (!slug || !entry) {
  return new Response('Event not found', { status: 404 });
}

const authed = verifyToken(slug, Astro.cookies.get(cookieName(slug))?.value);

const rendered = authed ? await entry.render() : null;
const Content = rendered?.Content ?? null;

let rsvps: Rsvp[] = [];
let rsvpError = false;
if (authed) {
  try {
    rsvps = await getRsvps(slug);
  } catch {
    rsvpError = true;
  }
}

const unlockFailed = Astro.url.searchParams.get('error') === '1';
const rsvpStatus = Astro.url.searchParams.get('rsvp'); // 'ok' | 'removed' | 'err' | null

const { title, date, location, address, host, description, banner, theme } = entry.data;
const whenText = date.toLocaleString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});
const whereText = [location, address].filter(Boolean).join(' · ');

// Theme + decorative assets (image filenames contain spaces -> encodeURI).
const themeClass = theme === 'thanksgiving' ? 'theme-thanksgiving' : '';
const bannerSrc = banner ? encodeURI(banner) : null;
const divider = encodeURI('/images/events/friendsgiving/friendsgivingArtboard 2 copy 2.png');
const lockLeaf = encodeURI('/images/events/friendsgiving/friendsgivingArtboard 2 copy 5.png');

// Falling-leaf "confetti rain" — the small single-leaf artworks, scattered with
// randomized position / size / speed so no two fall the same. Rendered only when themed.
const LEAF_BASE = '/images/events/friendsgiving/';
const LEAF_ART = [
  'friendsgivingArtboard 2.png',
  'friendsgivingArtboard 2 copy.png',
  'friendsgivingArtboard 2 copy 3.png',
  'friendsgivingArtboard 2 copy 4.png',
  'friendsgivingArtboard 2 copy 5.png',
];
const LEAF_COUNT = 18;
const fallingLeaves = Array.from({ length: LEAF_COUNT }, (_, i) => ({
  src: encodeURI(LEAF_BASE + LEAF_ART[i % LEAF_ART.length]),
  left: +(Math.random() * 100).toFixed(2),      // vw across the screen
  size: 20 + Math.round(Math.random() * 26),    // 20–46px
  fallDur: +(9 + Math.random() * 8).toFixed(1), // 9–17s to reach the bottom
  swayDur: +(2.5 + Math.random() * 2.5).toFixed(1),
  delay: +(-Math.random() * 17).toFixed(1),     // negative => start mid-fall (no empty screen)
  opacity: +(0.55 + Math.random() * 0.35).toFixed(2),
}));
---

<BaseLayout
  title={authed ? title : 'Private event'}
  description={authed ? (description ?? '') : 'This event is password protected.'}
>
  <article class={`event ${themeClass}`}>
    {themeClass && (
      <div class="leaf-fall" aria-hidden="true">
        {fallingLeaves.map((l) => (
          <span
            class="leaf"
            style={`left:${l.left}vw; animation-duration:${l.fallDur}s; animation-delay:${l.delay}s;`}
          >
            <img
              src={l.src}
              alt=""
              style={`width:${l.size}px; opacity:${l.opacity}; animation-duration:${l.swayDur}s; animation-delay:${l.delay}s;`}
            />
          </span>
        ))}
      </div>
    )}

    <div class="container event-wrap">
      <a href="/events" class="back-link"><span aria-hidden="true">←</span> All events</a>

      {bannerSrc && (
        <div class="event-banner">
          <img src={bannerSrc} alt={title} />
        </div>
      )}

      {authed && Content ? (
        <>
          <header class="event-head">
            <h1 class="event-title">{title}</h1>

            <dl class="event-facts">
              <div class="event-fact">
                <dt class="meta">When</dt>
                <dd><time datetime={date.toISOString()}>{whenText}</time></dd>
              </div>
              {whereText && (
                <div class="event-fact">
                  <dt class="meta">Where</dt>
                  <dd>{whereText}</dd>
                </div>
              )}
              {host && (
                <div class="event-fact">
                  <dt class="meta">Host</dt>
                  <dd>{host}</dd>
                </div>
              )}
            </dl>

            <a class="btn" href={`/api/ics?slug=${encodeURIComponent(slug)}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" />
              </svg>
              Add to calendar (.ics)
            </a>
          </header>

          <div class="event-body prose">
            <Content />
          </div>

          {themeClass && <img class="leaf-divider" src={divider} alt="" aria-hidden="true" />}

          <section class="rsvp" aria-labelledby="rsvp-heading">
            <header class="rsvp-header">
              <h2 id="rsvp-heading">RSVP</h2>
            </header>

            {rsvpStatus === 'ok' && <p class="msg ok">Thanks — you're on the list! 🎉</p>}
            {rsvpStatus === 'removed' && <p class="msg ok">RSVP removed.</p>}
            {rsvpStatus === 'err' && <p class="msg err">Something went wrong saving your RSVP. Try again.</p>}

            <form class="rsvp-form" method="POST" action="/api/rsvp">
              <input type="hidden" name="slug" value={slug} />
              <input class="field" type="text" name="name" placeholder="Your name" aria-label="Your name" required maxlength="80" />
              <input class="field" type="text" name="bringing" placeholder="What you'll bring" aria-label="What you'll bring" maxlength="120" />
              <input class="field" type="text" name="note" placeholder="Note (optional)" aria-label="Note" maxlength="200" />
              <button type="submit" class="btn">Send RSVP</button>
            </form>

            <h3 class="rsvp-subhead">
              Who's coming {!rsvpError && <span class="meta rsvp-count">{rsvps.length}</span>}
            </h3>
            {rsvpError ? (
              <p class="msg err">RSVPs are temporarily unavailable.</p>
            ) : rsvps.length === 0 ? (
              <p class="muted">No RSVPs yet — be the first.</p>
            ) : (
              <ul class="rsvp-list">
                {rsvps.map((r) => (
                  <li>
                    <span class="rsvp-who">
                      <strong>{r.name}</strong>
                      {r.bringing && <span class="rsvp-bringing">{r.bringing}</span>}
                      {r.note && <span class="rsvp-note">{r.note}</span>}
                    </span>
                    <form
                      class="rsvp-del"
                      method="POST"
                      action="/api/rsvp"
                      onsubmit="return confirm('Remove this RSVP?');"
                    >
                      <input type="hidden" name="slug" value={slug} />
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button type="submit" class="del-btn" aria-label={`Remove ${r.name}'s RSVP`}>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                          <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </>
      ) : (
        <div class="event-lock">
          {themeClass && <img class="lock-leaf" src={lockLeaf} alt="" aria-hidden="true" />}
          <h1 class="event-title"><span class="accent-stop">Private event</span></h1>
          <p class="muted">Enter the password to see the details.</p>
          {unlockFailed && <p class="msg err">Incorrect password — try again.</p>}
          <form class="lock-form" method="POST" action="/api/unlock">
            <input type="hidden" name="slug" value={slug} />
            <input class="field" type="password" name="password" placeholder="Password" aria-label="Password" required autofocus />
            <button type="submit" class="btn">Unlock</button>
          </form>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  /* .container supplies the responsive horizontal padding; we only add vertical.
     position/z-index keep the content above the falling-leaf overlay. */
  .event-wrap {
    max-width: calc(var(--content-width) + 2 * var(--spacing-md));
    padding-block: var(--spacing-md) var(--spacing-xl);
    position: relative;
    z-index: 1;
  }

  /* ── Falling-leaf "confetti rain" — fixed, full-viewport, behind the content ── */
  .leaf-fall {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .leaf-fall .leaf {
    position: absolute;
    top: -12vh;
    will-change: transform;
    animation-name: leaf-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .leaf-fall .leaf img {
    display: block;
    will-change: transform;
    animation-name: leaf-sway;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  @keyframes leaf-fall {
    to { transform: translateY(124vh); }
  }
  @keyframes leaf-sway {
    from { transform: translateX(-14px) rotate(-22deg); }
    to   { transform: translateX(14px) rotate(26deg); }
  }
  /* Respect users who prefer less motion — no rain for them. */
  @media (prefers-reduced-motion: reduce) {
    .leaf-fall { display: none; }
  }

  /* ── Banner ── */
  .event-banner {
    position: relative;
    margin: var(--spacing-sm) 0 var(--spacing-md);
    border-radius: 4px;
    overflow: hidden;
  }
  .event-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }
  .event-banner img {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
  }

  /* ── Header ── */
  .event-head {
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-accent);
  }

  .event-title {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: var(--spacing-sm) 0 var(--spacing-md);
  }

  .event-facts {
    margin-bottom: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .event-fact {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--spacing-sm);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .event-fact dt {
    padding-top: 0.15rem;
  }

  .event-fact dd {
    color: var(--color-text);
  }

  .event-body {
    margin: var(--spacing-lg) 0;
  }

  /* Decorative leaf divider between the story and the RSVP */
  .leaf-divider {
    display: block;
    width: 280px;
    max-width: 70%;
    margin: var(--spacing-md) auto;
  }

  /* ── Form controls ── */
  .field {
    flex: 1 1 10rem;
    min-height: 44px;
    padding: 0 0.875rem;
    border: none;
    border-radius: 6px;
    background: var(--color-bg-elevated);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    font-family: var(--font-family);
    font-size: 0.9375rem;
    transition: box-shadow 150ms var(--ease-out);
  }

  .field::placeholder {
    color: var(--color-text-muted);
  }

  .field:focus {
    outline: none;
    box-shadow:
      inset 0 0 0 1px var(--color-accent),
      0 0 0 3px color-mix(in oklab, var(--color-accent) 25%, transparent);
  }

  .rsvp-form .btn,
  .lock-form .btn {
    min-height: 44px;
  }

  /* ── RSVP ── */
  .rsvp {
    margin-top: var(--spacing-lg);
  }

  .rsvp-header {
    padding-bottom: 0.75rem;
    margin-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-accent);
  }

  .rsvp-header h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .rsvp-form,
  .lock-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: var(--spacing-sm) 0 var(--spacing-md);
  }

  .rsvp-subhead {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 1.125rem;
    margin: var(--spacing-md) 0 0;
    padding-bottom: 0.75rem;
  }

  .rsvp-count {
    color: var(--color-accent);
  }

  .rsvp-list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .rsvp-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .rsvp-who {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .rsvp-bringing {
    color: var(--color-text-muted);
  }

  .rsvp-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .rsvp-del {
    margin: 0;
    flex: 0 0 auto;
  }

  .del-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }

  .del-btn:hover,
  .del-btn:focus-visible {
    color: var(--color-text);
    background: rgb(255 255 255 / 0.06);
  }

  .msg {
    padding: 0.4rem 0;
    margin: 0;
  }
  .msg.ok { color: #4caf7d; }
  .msg.err { color: #e0795b; }
  .muted { color: var(--color-text-muted); }

  /* ── Locked view ── */
  .event-lock {
    padding: var(--spacing-md) 0 var(--spacing-lg);
  }

  .event-lock .lock-leaf {
    width: 72px;
    margin-bottom: var(--spacing-sm);
  }

  .event-lock .event-title {
    margin-bottom: var(--spacing-xs);
  }

  .lock-form {
    max-width: 420px;
  }

  /* ---------- Thanksgiving theme ----------
     Overriding --color-accent on the wrapper cascades to links, buttons, rules,
     the title full stop, and every accent beneath it. */
  .theme-thanksgiving {
    --color-accent: #d2763a;       /* rust-orange */
    --color-accent-hover: #e3a43c; /* gold */
  }
  .theme-thanksgiving .event-title,
  .theme-thanksgiving .rsvp h2,
  .theme-thanksgiving .rsvp h3 {
    color: #f3dcc0; /* warm cream, matches the banner lettering */
  }
  .theme-thanksgiving .event-banner {
    box-shadow: 0 10px 30px rgba(74, 37, 41, 0.45);
  }
  .theme-thanksgiving .event-fact,
  .theme-thanksgiving .event-facts,
  .theme-thanksgiving .rsvp-list,
  .theme-thanksgiving .rsvp-list li {
    border-color: rgba(210, 118, 58, 0.22);
  }
  .theme-thanksgiving .field {
    background: rgba(90, 48, 52, 0.4);
    box-shadow: inset 0 0 0 1px rgba(210, 118, 58, 0.28);
  }
  .theme-thanksgiving .field:focus {
    box-shadow:
      inset 0 0 0 1px var(--color-accent),
      0 0 0 3px rgba(210, 118, 58, 0.25);
  }

  @media (max-width: 640px) {
    .event-banner img { max-height: 200px; }
  }
</style>
