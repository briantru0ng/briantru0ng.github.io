---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publicAssetExists } from '../../lib/publicAsset';

// Public listing of event metadata only (title/date/description/image).
// The details, .ics, and RSVP stay password-gated on /events/<slug>.
const EVENT_TZ = 'America/New_York';

const events = (await getCollection('events', ({ data }) => data.shown))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(event => ({
    event,
    // image paths may contain spaces: check the raw path, serve the encoded one
    image: publicAssetExists(event.data.image) ? encodeURI(event.data.image) : undefined,
    initial: event.data.title.trim().charAt(0).toUpperCase(),
    day: event.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: EVENT_TZ }),
    // built from parts: a combined weekday+year format renders as "2026 Sat"
    weekdayYear: `${event.data.date.toLocaleDateString('en-US', { weekday: 'short', timeZone: EVENT_TZ })}, ${event.data.date.toLocaleDateString('en-US', { year: 'numeric', timeZone: EVENT_TZ })}`,
  }));
---

<BaseLayout title="Events" description="Private events hosted by Brian.">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Events</h1>
      <p class="page-description">Private gatherings — enter the password to see the details.</p>
    </header>

    {events.length === 0 ? (
      <p class="empty">No events right now. Check back soon.</p>
    ) : (
      <div class="events-list">
        {events.map(({ event, image, initial, day, weekdayYear }) => (
          <a href={`/events/${event.slug}`} class="event-row">
            <time class="event-when" datetime={event.data.date.toISOString()}>
              <span class="event-day">{day}</span>
              <span class="meta">{weekdayYear}</span>
            </time>

            <div class="event-info">
              <h2 class="event-title">{event.data.title}</h2>
              {event.data.description && <p class="event-desc">{event.data.description}</p>}
              <span class="event-lock meta">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                Password required
              </span>
            </div>

            <div class="event-image-wrapper">
              {image ? (
                <img src={image} alt="" class="event-image" loading="lazy" />
              ) : (
                <span class="placeholder-initial" aria-hidden="true">{initial}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  /* Same ledger rows as /projects; the page-header rule doubles as the top rule */
  .events-list {
    margin-top: calc(-1 * var(--spacing-lg));
    margin-bottom: var(--spacing-xl);
  }

  .event-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 220px;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }

  .event-when {
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 0.2rem;
  }

  .event-day {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .event-title {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
    transition: color 150ms var(--ease-out);
  }

  .event-desc {
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-lock {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .event-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .event-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 150ms var(--ease-out);
  }

  .event-row:hover .event-title {
    color: var(--color-accent);
  }

  .event-row:hover .event-image {
    opacity: 1;
  }

  .empty {
    color: var(--color-text-muted);
    padding-bottom: var(--spacing-xl);
  }

  @media (max-width: 720px) {
    .event-row {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: var(--spacing-sm);
    }

    .event-image-wrapper {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
</style>
