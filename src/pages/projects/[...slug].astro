---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicAssetExists } from '../../lib/publicAsset';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.shown);
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const formattedDate = project.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

const tags = project.data.tags ?? [];
const hasLinks = Boolean(project.data.link || project.data.github);
const image = publicAssetExists(project.data.image) ? project.data.image : undefined;
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="project-detail">
    <div class="container">
      <a href="/projects" class="back-link"><span aria-hidden="true">←</span> All projects</a>

      <header class:list={['project-header', { 'has-image': image }]}>
        <div class="project-header-text">
          <time class="meta" datetime={project.data.date.toISOString()}>{formattedDate}</time>
          <h1 class="project-title">{project.data.title}</h1>
          <p class="project-description">{project.data.description}</p>

          {tags.length > 0 && (
            <dl class="project-facts">
              <dt class="meta">Stack</dt>
              <dd>{tags.join(', ')}</dd>
            </dl>
          )}

          {hasLinks && (
            <div class="project-links">
              {project.data.link && (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="btn">
                  View live <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.data.github && (
                <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </div>

        {image && (
          <div class="project-header-image">
            <img src={image} alt={project.data.title} class="project-image" />
          </div>
        )}
      </header>

      <div class="project-content prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding: var(--spacing-md) 0 var(--spacing-xl);
  }

  .project-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-lg);
    align-items: center;
    padding-bottom: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .project-header.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
  }

  /* Without an image, keep the header (and its rule) on the same measure as the prose */
  .project-header:not(.has-image) {
    max-width: var(--content-width);
  }

  .project-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0.5rem 0 var(--spacing-sm);
  }

  .project-description {
    font-size: 1.125rem;
    margin-bottom: var(--spacing-md);
  }

  .project-facts {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--spacing-sm);
    padding: 0.875rem 0;
    margin-bottom: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .project-facts dt {
    padding-top: 0.15rem;
  }

  .project-facts dd {
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-header-image {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .project-header-image::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .project-header,
    .project-header.has-image {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .project-header-image {
      order: -1;
      aspect-ratio: 16 / 9;
    }
  }
</style>
