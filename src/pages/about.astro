---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const byDateAsc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  a.data.date.valueOf() - b.data.date.valueOf();

const lifePosts = (await getCollection('blog', ({ id, data }) => id.startsWith('life/') && data.shown)).sort(byDateAsc);
const foodPosts = (await getCollection('blog', ({ id, data }) => id.startsWith('food/') && data.shown)).sort(byDateAsc);
const artPosts = (await getCollection('blog', ({ id, data }) => id.startsWith('art/') && data.shown)).sort(byDateAsc);

const blogSections = [
  {
    id: 'life-blog',
    category: 'life' as const,
    title: 'Life & Thoughts',
    description: 'Average until proven unique',
    empty: 'Seeing this means my life has been uneventful. I need to touch grass...',
    posts: lifePosts,
  },
  {
    id: 'food-blog',
    category: 'food' as const,
    title: 'Food Blog',
    description: "Oh I'm big backing it. Oh I'm big backing it. Oh I'm big bac-",
    empty: 'No food posts yet? I am not real.',
    posts: foodPosts,
  },
  {
    id: 'art-blog',
    category: 'art' as const,
    title: 'Art Blog',
    description: 'Art that proves my humanity in the face of simulations',
    empty: 'No art posts yet. Check back soon!',
    posts: artPosts,
  },
  // Sections with posts first; empty ones drop to the bottom (stable sort keeps original order)
].sort((a, b) => Number(b.posts.length > 0) - Number(a.posts.length > 0));

const skills = ['Python', 'PyTorch', 'AI/ML', 'Backend Development', 'Rust', 'Japanese Language'];

const ICON_LINKEDIN = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const ICON_EMAIL = 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z';
const ICON_GITHUB = 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z';

const contacts = [
  { type: 'linkedin', label: 'LinkedIn', url: 'https://www.linkedin.com/in/briantru0ng/', icon: ICON_LINKEDIN },
  { type: 'email', label: 'Email', url: 'mailto:briantru0ng.careers@gmail.com', icon: ICON_EMAIL },
  { type: 'github', label: 'GitHub', url: 'https://github.com/briantru0ng', icon: ICON_GITHUB },
];
---

<BaseLayout title="Brian's Life" description="Learn more about Brian Truong">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">About Me</h1>
      <p class="page-description">A bit about who I am and what I do.</p>
    </header>

    <div class="about-content">
      <figure class="about-figure">
        <div class="about-image-frame">
          <img src="/images/DSC_0276.JPG" alt="Brian Truong" class="about-image" />
        </div>
        <figcaption class="meta">DSC_0276.JPG</figcaption>
      </figure>

      <div class="about-text content">
        <h2>Whaddup Whaddup Whaddup!</h2>
        <p>
          I'm Brian, a software developer passionate about building things that live on the internet.
          I enjoy creating experiences that are both functional and delightful to use.
        </p>

        <p>
          When I'm not coding, you can find me exploring new cuisines, working on art projects,
          or learning something new. I believe in continuous growth and the power of curiosity.
        </p>

        <dl class="facts">
          <div class="fact">
            <dt class="meta">Skills &amp; interests</dt>
            <dd class="skills">
              {skills.map(skill => <span class="tag">{skill}</span>)}
            </dd>
          </div>

          <div class="fact">
            <dt class="meta">Currently</dt>
            <dd>
              <ul class="currently">
                <li>Adjusting to my new environment</li>
                <li>Learning new technologies</li>
                <li>Sharing snippets of my life through the blogs below</li>
              </ul>
            </dd>
          </div>

          <div class="fact">
            <dt class="meta">Let's connect</dt>
            <dd class="contact-links">
              {contacts.map(contact => (
                <button class="contact-btn" type="button" data-type={contact.type} data-url={contact.url}>
                  <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                    <path d={contact.icon} />
                  </svg>
                  <span>{contact.label}</span>
                </button>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Contact Modal -->
    <div class="contact-modal" id="contactModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-backdrop"></div>
      <div class="modal-content">
        <button class="modal-close" type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
        <div class="modal-icon" aria-hidden="true">
          {contacts.map(contact => (
            <svg viewBox="0 0 24 24" fill="currentColor" data-icon={contact.type} hidden>
              <path d={contact.icon} />
            </svg>
          ))}
        </div>
        <h3 class="modal-title" id="modalTitle"></h3>
        <p class="modal-message" id="modalMessage"></p>
        <a class="btn modal-proceed-btn" id="modalProceed" href="#" target="_blank" rel="noopener noreferrer">
          ok man. lemme proceed
        </a>
      </div>
    </div>

    <div id="blogs" class="blogs">
    {blogSections.map(section => (
      <section id={section.id} class:list={['blog-section', { 'is-empty': section.posts.length === 0 }]}>
        <header class="blog-section-header">
          <div>
            <h2 class="section-title">
              <a href={`/blog/${section.category}`}>{section.title}</a>
            </h2>
            <p class="section-description">{section.description}</p>
          </div>
          {section.posts.length > 0 && (
            <a href={`/blog/${section.category}`} class="section-all">
              See all <span class="meta">({section.posts.length})</span> →
            </a>
          )}
        </header>

        {section.posts.length > 0 ? (
          <div class="blog-shelf">
            {section.posts.map(post => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                image={post.data.image}
                slug={post.slug.replace(`${section.category}/`, '')}
                category={section.category}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">{section.empty}</p>
        )}
      </section>
    ))}
    </div>
  </div>
</BaseLayout>

<style>
  .about-content {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
  }

  /* ── Photo ── */
  .about-figure {
    position: sticky;
    top: calc(var(--nav-height) + var(--spacing-md));
    height: fit-content;
  }

  .about-image-frame {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .about-image-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    outline: var(--image-outline);
    outline-offset: -1px;
    pointer-events: none;
  }

  .about-image {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* ── Text ── */
  .about-text h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.03em;
    margin-bottom: var(--spacing-md);
  }

  .about-text p {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .facts {
    margin-top: var(--spacing-md);
    border-top: 1px solid var(--color-accent);
  }

  .fact {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--spacing-sm);
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .fact dt {
    padding-top: 0.2rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .currently {
    list-style: none;
  }

  .currently li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .currently li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  /* ── Contact buttons ── */
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 0.9rem;
    background: transparent;
    border: none;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition-property: background-color, box-shadow, scale;
    transition-duration: 150ms;
    transition-timing-function: var(--ease-out);
  }

  .contact-btn svg {
    color: var(--color-text-muted);
    transition: color 150ms var(--ease-out);
  }

  .contact-btn:hover {
    background: var(--color-bg-elevated);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  .contact-btn:hover svg {
    color: var(--color-accent);
  }

  .contact-btn:active {
    scale: 0.96;
  }

  /* ── Modal ── */
  .contact-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-sm);
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms var(--ease-out), visibility 200ms var(--ease-out);
  }

  .contact-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.7);
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 400px;
    padding: 2rem;
    background: var(--color-bg-elevated);
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 24px 48px -12px rgb(0 0 0 / 0.6);
    translate: 0 8px;
    transition: translate 200ms var(--ease-out);
  }

  .contact-modal.active .modal-content {
    translate: 0 0;
  }

  .modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }

  .modal-close:hover {
    color: var(--color-text);
    background: rgb(255 255 255 / 0.06);
  }

  .modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 1.25rem;
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .modal-icon svg {
    width: 22px;
    height: 22px;
  }

  /* `hidden` isn't honored on SVG elements by the UA stylesheet, so enforce it */
  .modal-icon svg[hidden] {
    display: none;
  }

  .modal-title {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    padding-right: 2rem;
  }

  .modal-message {
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .modal-proceed-btn {
    width: 100%;
    justify-content: center;
    min-height: 44px;
  }

  /* ── Blog shelves ── */
  .blog-section {
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: var(--nav-height);
  }

  .blog-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
  }

  .section-title a {
    color: var(--color-text);
  }

  .section-title a:hover {
    color: var(--color-accent);
  }

  .section-description {
    margin: 0;
  }

  .section-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .section-all:hover {
    color: var(--color-text);
  }

  .blog-shelf {
    display: flex;
    gap: var(--spacing-md);
    overflow-x: auto;
    padding-bottom: var(--spacing-sm);
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .blog-shelf > :global(.blog-card) {
    flex: 0 0 260px;
    scroll-snap-align: start;
  }

  .blogs {
    scroll-margin-top: var(--nav-height);
  }

  /* Empty sections collapse to a single compact row */
  .blog-section.is-empty {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
  }

  .blog-section.is-empty .blog-section-header {
    margin-bottom: 0;
  }

  .blog-section.is-empty .section-title {
    font-size: 1.375rem;
  }

  .empty-state {
    color: var(--color-text-muted);
    margin: 0;
  }

  .blog-section:last-child {
    padding-bottom: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .about-figure {
      position: static;
      max-width: 240px;
    }

    .fact {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .blog-section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .blog-section.is-empty {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
    }

    .blog-shelf > :global(.blog-card) {
      flex-basis: 72%;
    }
  }
</style>

<script>
  const contactMessages: Record<string, { title: string; message: string }> = {
    linkedin: {
      title: "Connecting on LinkedIn?",
      message: "I think I've become disillusioned with the whole LinkedIn space. I feel like it's become a place that shouldn't be taken seriously anymore. I'll connect with you and we can have a brief conversation though:)",
    },
    email: {
      title: "Send me a high-paying offer?",
      message: "Send it to me here! OOoo I'm so money motivated $)",
    },
    github: {
      title: "Check Out My Code!",
      message: "Where I go to prove my worth as a developer. Come watch me in this Coding Colosseum",
    },
  };

  const modal = document.getElementById('contactModal');
  const modalTitle = document.getElementById('modalTitle');
  const modalMessage = document.getElementById('modalMessage');
  const modalProceed = document.getElementById('modalProceed') as HTMLAnchorElement | null;
  const modalClose = document.querySelector<HTMLButtonElement>('.modal-close');
  const modalBackdrop = document.querySelector('.modal-backdrop');
  const modalIcons = document.querySelectorAll<SVGElement>('.modal-icon [data-icon]');

  let lastTrigger: HTMLElement | null = null;

  function openModal(type: string | undefined, url: string | undefined) {
    const config = type ? contactMessages[type] : undefined;
    if (!config || !url) return;

    modalIcons.forEach(icon => icon.toggleAttribute('hidden', icon.dataset.icon !== type));
    if (modalTitle) modalTitle.textContent = config.title;
    if (modalMessage) modalMessage.textContent = config.message;
    if (modalProceed) {
      modalProceed.href = url;
      if (type === 'email') {
        modalProceed.removeAttribute('target');
      } else {
        modalProceed.setAttribute('target', '_blank');
      }
    }

    modal?.classList.add('active');
    document.body.style.overflow = 'hidden';
    modalClose?.focus();
  }

  function closeModal() {
    if (!modal?.classList.contains('active')) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
    lastTrigger?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>('.contact-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      lastTrigger = btn;
      openModal(btn.dataset.type, btn.dataset.url);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  modalProceed?.addEventListener('click', () => {
    setTimeout(closeModal, 100);
  });
</script>
